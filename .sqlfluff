[sqlfluff]
dialect = postgres
max_line_length = 120
templater = raw
large_file_skip_byte_limit = 50000
exclude_rules =
    LT01, LT02, LT05, LT12, LT14,
    ST05, ST06, ST09,
    AM04, AM05, AM09,
    CP03, CP04,
    AL01, AL02, AL03, AL07,
    RF01, RF02, RF03, RF04,
    CV10, CV11

# db/queries/ is demo/teaching material: intentionally includes DO $$ …$$,
# SAVEPOINT blocks, multi-statement sessions that sqlfluff can't parse cleanly.
# db/*.sql is the canonical schema and must lint clean.

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper
