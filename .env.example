# ============================================================================
# Restaurant Ordering System — environment configuration
# Copy this file to `.env` and fill in the secrets for your local setup.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets.
# ============================================================================

# ---- Postgres ---------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=restaurant_ordering

# Migration / ops account. Owns the schema. Do NOT use for the app pool.
POSTGRES_USER=ros_admin
POSTGRES_PASSWORD=change-me-locally

# Least-privilege account used by the FastAPI connection pool.
# Created by db/11_roles_grants.sql. Must NOT be a superuser so RLS is enforced.
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-locally

# ---- pgAdmin (docker-compose only) -----------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@ros.local
PGADMIN_DEFAULT_PASSWORD=admin

# ---- FastAPI ----------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POOL_MIN_SIZE=2
POOL_MAX_SIZE=10

# ---- Ports for run.sh -------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
